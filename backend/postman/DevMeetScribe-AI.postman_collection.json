          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}",
            "tasks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Update API documentation\",\n  \"assignee\": \"Amit\",\n  \"deadline\": \"Before the demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
