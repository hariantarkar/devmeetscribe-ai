{
  "info": {
    "name": "DevMeetScribe AI - Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "2. Create meeting",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/meetings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Sprint sync\",\n  \"transcript\": \"Rahul: Good morning everyone. Let's go over the sprint status. Priya: The registration module is done, but we still have two open bugs in the login flow. Rahul: We need to finish the student login API by Friday. Priya, can you also test the registration endpoint? Priya: Sure, I'll test the registration endpoint by Thursday. Amit: For the database, we decided to go with PostgreSQL instead of MySQL. We still need to discuss the migration plan. Rahul: Agreed. Someone should also update the API documentation before the demo. Rahul: Okay, the next release is on the 20th. Let's wrap up.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('meetingId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Analyze meeting (calls Ollama)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}/analyze",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}",
            "analyze"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().tasks;",
              "if (t && t.length) { pm.collectionVariables.set('taskId', t[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get meeting",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}",
