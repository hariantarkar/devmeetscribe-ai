{
  "info": {
    "name": "DevMeetScribe AI - Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0a. Register (first time only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"demo12345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token returned', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "0b. Login (sets the token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"demo12345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token returned', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "0c. Who am I",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "1. Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "2. Create meeting",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/meetings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Sprint sync\",\n  \"transcript\": \"Rahul: Good morning everyone. Let's go over the sprint status. Priya: The registration module is done, but we still have two open bugs in the login flow. Rahul: We need to finish the student login API by Friday. Priya, can you also test the registration endpoint? Priya: Sure, I'll test the registration endpoint by Thursday. Amit: For the database, we decided to go with MySQL instead of PostgreSQL. We still need to discuss the migration plan. Rahul: Agreed. Someone should also update the API documentation before the demo.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('meetingId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Analyze meeting (calls Ollama)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}/analyze",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}",
            "analyze"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().tasks;",
              "if (t && t.length) { pm.collectionVariables.set('taskId', t[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get meeting",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}"
          ]
        }
      }
    },
    {
      "name": "5. List my meetings",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings"
          ]
        }
      }
    },
    {
      "name": "6. List tasks of meeting",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "7. Add task manually",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}",
            "tasks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Update API documentation\",\n  \"assignee\": \"Amit\",\n  \"deadline\": \"Before the demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. Update task (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"assignee\": \"Priya\",\n  \"deadline\": \"Friday\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. List my pending tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tasks?status=PENDING",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ],
          "query": [
            {
              "key": "status",
              "value": "PENDING"
            }
          ]
        }
      }
    },
    {
      "name": "10. Chat: ask a question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}",
            "chat"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What did we decide about the database?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11. Chat: history",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}",
            "chat"
          ]
        }
      }
    },
    {
      "name": "12. Draft follow-up email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}/email",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}",
            "email"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tone\": \"professional\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13. Delete task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}"
          ]
        }
      }
    },
    {
      "name": "14. Delete meeting",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings/{{meetingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings",
            "{{meetingId}}"
          ]
        }
      }
    },
    {
      "name": "Unauthorized demo (no token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/meetings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Validation error demo (blank title)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/meetings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "meetings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"transcript\": \"x\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "meetingId",
      "value": "1"
    },
    {
      "key": "taskId",
      "value": "1"
    }
  ]
}